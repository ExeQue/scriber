# Scriber theme for every Omarchy theme.
# Copy this file to ~/.config/omarchy/themed/scriber.toml.tpl and switch theme once:
# Omarchy then writes a matching scriber.toml into each theme it applies, and Scriber
# (Theme: System or Omarchy) uses it. Add Scriber-only keys (canvas, material, cut, …)
# here to tune every theme at once; docs/guide/themes.md lists them all.
background = "{{ background }}"
foreground = "{{ foreground }}"
accent = "{{ accent }}"
selection = "{{ selection_background }}"
muted = "{{ muted }}"
red = "{{ red }}"
yellow = "{{ yellow }}"
green = "{{ green }}"
